# Dockerfile
FROM python:3.11-slim

WORKDIR /app

# Evitar archivos .pyc y habilitar salida en tiempo real en consola
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

# Instalar dependencias fijadas
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copiar código fuente, configuraciones y pruebas
COPY configs/ ./configs/
COPY src/ ./src/
COPY scripts/ ./scripts/
COPY tests/ ./tests/
COPY models_saved/ ./models_saved/

# Comando por defecto: ejecutar pruebas unitarias, entrenar agente y correr evaluación V1
CMD ["sh", "-c", "pytest && python -m scripts.train_agent && python -m scripts.run_experiments"]